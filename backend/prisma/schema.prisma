generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activity_logs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  user_id      String?    @db.Uuid
  action_type  String     @db.VarChar(50)
  entity_type  String?    @db.VarChar(30)
  entity_id    String?    @db.Uuid
  description  String
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  users        users?     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_activity_logs_user")
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_activity_logs_workspace")

  @@index([created_at], map: "idx_activity_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_activity_logs_entity")
  @@index([user_id], map: "idx_activity_logs_user_id")
  @@index([workspace_id], map: "idx_activity_logs_workspace_id")
}

model attachments {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id     String?   @db.Uuid
  project_id  String?   @db.Uuid
  uploaded_by String    @db.Uuid
  file_name   String    @db.VarChar(255)
  file_url    String
  file_type   String?   @db.VarChar(100)
  file_size   BigInt?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  projects    projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attachments_project")
  tasks       tasks?    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attachments_task")
  users       users     @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "fk_attachments_user")

  @@index([project_id], map: "idx_attachments_project_id")
  @@index([task_id], map: "idx_attachments_task_id")
  @@index([uploaded_by], map: "idx_attachments_uploaded_by")
}

model comments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String   @db.Uuid
  user_id    String   @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comments_task")
  users      users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_comments_user")

  @@index([created_at], map: "idx_comments_created_at")
  @@index([task_id], map: "idx_comments_task_id")
  @@index([user_id], map: "idx_comments_user_id")
}

model decisions {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String   @db.Uuid
  decision      String
  reason        String?
  decision_date DateTime @db.Date
  owner_id      String?  @db.Uuid
  status        String   @default("Proposed") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_decisions_owner")
  projects      projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_decisions_project")

  @@index([decision_date], map: "idx_decisions_date")
  @@index([owner_id], map: "idx_decisions_owner_id")
  @@index([project_id], map: "idx_decisions_project_id")
  @@index([status], map: "idx_decisions_status")
}

model labels {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String        @db.Uuid
  name         String        @db.VarChar(50)
  color        String?       @db.VarChar(20)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  workspaces   workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_labels_workspace")
  task_labels  task_labels[]

  @@unique([workspace_id, name], map: "uq_workspace_label")
  @@index([workspace_id], map: "idx_labels_workspace_id")
}

model notifications {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  type                String   @db.VarChar(30)
  message             String
  related_entity_type String?  @db.VarChar(30)
  related_entity_id   String?  @db.Uuid
  is_read             Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([created_at], map: "idx_notifications_created_at")
  @@index([user_id, is_read], map: "idx_notifications_unread")
  @@index([user_id], map: "idx_notifications_user_id")
}

model project_members {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String   @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  joined_at  DateTime @default(now()) @db.Timestamptz(6)
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_members_project")
  roles      roles    @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_project_members_role")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_members_user")

  @@unique([project_id, user_id], map: "uq_project_member")
  @@index([user_id], map: "idx_project_members_user_id")
}

model projects {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String            @db.Uuid
  title           String            @db.VarChar(150)
  description     String?
  category        String?           @db.VarChar(50)
  priority        String            @default("Medium") @db.VarChar(20)
  status          String            @default("Planning") @db.VarChar(20)
  start_date      DateTime?         @db.Date
  end_date        DateTime?         @db.Date
  manager_id      String            @db.Uuid
  is_archived     Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  attachments     attachments[]
  decisions       decisions[]
  project_members project_members[]
  users           users             @relation(fields: [manager_id], references: [id], onUpdate: NoAction, map: "fk_projects_manager")
  workspaces      workspaces        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_projects_workspace")
  risks           risks[]
  tasks           tasks[]
}

model risks {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id      String   @db.Uuid
  title           String   @db.VarChar(200)
  description     String?
  severity        String   @default("Medium") @db.VarChar(20)
  probability     String   @default("Medium") @db.VarChar(20)
  owner_id        String?  @db.Uuid
  mitigation_plan String?
  status          String   @default("Open") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users?   @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_risks_owner")
  projects        projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_risks_project")

  @@index([owner_id], map: "idx_risks_owner_id")
  @@index([project_id], map: "idx_risks_project_id")
  @@index([status], map: "idx_risks_status")
}

model roles {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_name       String            @unique @db.VarChar(30)
  description     String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  project_members project_members[]
  users           users[]
}

model subtasks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id     String    @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  status      String    @default("To Do") @db.VarChar(20)
  due_date    DateTime? @db.Date
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  tasks       tasks     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subtasks_task")

  @@index([due_date], map: "idx_subtasks_due_date")
  @@index([task_id], map: "idx_subtasks_task_id")
}

model task_dependencies {
  task_id                                           String   @db.Uuid
  depends_on_task_id                                String   @db.Uuid
  created_at                                        DateTime @default(now()) @db.Timestamptz(6)
  tasks_task_dependencies_depends_on_task_idTotasks tasks    @relation("task_dependencies_depends_on_task_idTotasks", fields: [depends_on_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_dependencies_parent")
  tasks_task_dependencies_task_idTotasks            tasks    @relation("task_dependencies_task_idTotasks", fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_dependencies_task")

  @@id([task_id, depends_on_task_id], map: "pk_task_dependencies")
  @@index([depends_on_task_id], map: "idx_task_dependencies_depends_on")
}

model task_labels {
  task_id    String   @db.Uuid
  label_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  labels     labels   @relation(fields: [label_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_labels_label")
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_labels_task")

  @@id([task_id, label_id], map: "pk_task_labels")
  @@index([label_id], map: "idx_task_labels_label_id")
}

model tasks {
  id                                                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                                                    String              @db.Uuid
  title                                                         String              @db.VarChar(200)
  description                                                   String?
  priority                                                      String              @default("Medium") @db.VarChar(20)
  status                                                        String              @default("Backlog") @db.VarChar(20)
  start_date                                                    DateTime?           @db.Date
  due_date                                                      DateTime?           @db.Date
  estimated_hours                                               Decimal?            @db.Decimal(6, 2)
  assigned_to                                                   String?             @db.Uuid
  created_by                                                    String              @db.Uuid
  is_archived                                                   Boolean             @default(false)
  created_at                                                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime            @default(now()) @db.Timestamptz(6)
  attachments                                                   attachments[]
  comments                                                      comments[]
  subtasks                                                      subtasks[]
  task_dependencies_task_dependencies_depends_on_task_idTotasks task_dependencies[] @relation("task_dependencies_depends_on_task_idTotasks")
  task_dependencies_task_dependencies_task_idTotasks            task_dependencies[] @relation("task_dependencies_task_idTotasks")
  task_labels                                                   task_labels[]
  users_tasks_assigned_toTousers                                users?              @relation("tasks_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: NoAction, map: "fk_tasks_assigned_to")
  users_tasks_created_byTousers                                 users               @relation("tasks_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_tasks_created_by")
  projects                                                      projects            @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_project")

  @@index([assigned_to], map: "idx_tasks_assigned_to")
  @@index([created_by], map: "idx_tasks_created_by")
  @@index([due_date], map: "idx_tasks_due_date")
  @@index([project_id], map: "idx_tasks_project_id")
  @@index([project_id, status], map: "idx_tasks_project_status")
  @@index([status], map: "idx_tasks_status")
}

model users {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                        String                  @db.Uuid
  first_name                     String                  @db.VarChar(50)
  last_name                      String                  @db.VarChar(50)
  email                          String                  @unique @db.VarChar(255)
  password_hash                  String
  phone                          String?                 @db.VarChar(15)
  profile_picture                String?
  is_active                      Boolean                 @default(true)
  created_at                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                @default(now()) @db.Timestamptz(6)
  activity_logs                  activity_logs[]
  attachments                    attachments[]
  comments                       comments[]
  decisions                      decisions[]
  notifications                  notifications[]
  password_reset_tokens          password_reset_tokens[]
  project_members                project_members[]
  projects                       projects[]
  risks                          risks[]
  tasks_tasks_assigned_toTousers tasks[]                 @relation("tasks_assigned_toTousers")
  tasks_tasks_created_byTousers  tasks[]                 @relation("tasks_created_byTousers")
  roles                          roles                   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
  workspace_members              workspace_members[]
  workspaces                     workspaces[]

  @@index([role_id], map: "idx_users_role_id")
}

model workspace_members {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String     @db.Uuid
  user_id        String     @db.Uuid
  workspace_role String     @db.VarChar(30)
  joined_at      DateTime   @default(now()) @db.Timestamptz(6)
  users          users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workspace_members_user")
  workspaces     workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workspace_members_workspace")

  @@unique([workspace_id, user_id], map: "uq_workspace_member")
  @@index([user_id], map: "idx_workspace_members_user_id")
}

model workspaces {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(100)
  description       String?
  owner_id          String              @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  activity_logs     activity_logs[]
  labels            labels[]
  projects          projects[]
  workspace_members workspace_members[]
  users             users               @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_workspaces_owner")
}

model password_reset_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_tokens_user")

  @@index([user_id], map: "idx_password_reset_tokens_user_id")
  @@index([expires_at], map: "idx_password_reset_tokens_expires_at")
}
