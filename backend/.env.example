# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=taskflow"
DIRECT_URL="postgresql://user:password@localhost:5432/taskflow?schema=taskflow"

# Authentication & Cryptographic Secrets
JWT_SECRET="your_jwt_secret_key_minimum_32_chars"
RESET_PASSWORD_SECRET="your_password_reset_secret_key"
OTP_SECRET="your_otp_keyed_hmac_secret_key"

# CORS & Client Application URL
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,https://chipmunks-taskflow.vercel.app"

# Email Provider Configuration (Resend API)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Development / Debugging Toggles
LOG_DEV_AUTH_TOKENS="false"
DISABLE_RATE_LIMITING="false"
